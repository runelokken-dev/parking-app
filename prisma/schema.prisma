generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Apartment {
  id           String    @id @default(cuid())
  number       String    @unique // leilighetsnummer, f.eks. "505"
  andelsnummer String?
  name         String?
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

model ParkingSpot {
  id        String    @id @default(cuid())
  name      String    @unique // f.eks. "Plass 12"
  active    Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

enum BookingStatus {
  PENDING   // opprettet, venter på betaling (holder plassen midlertidig en kort stund)
  CONFIRMED // betalt og bekreftet
  CANCELLED // avbrutt av bruker/styret, eller betaling feilet/ble avbrutt
  EXPIRED   // aldri betalt innen tidsfristen
}

model Booking {
  id          String        @id @default(cuid())
  startTime   DateTime
  endTime     DateTime
  spot        ParkingSpot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  spotId      String
  apartment   Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  apartmentId String
  status      BookingStatus @default(PENDING)
  priceKr     Int
  paymentRef  String        @unique // vår egen unike referanse, sendt til Vipps
  vippsState  String?       // siste kjente status fra Vipps (til feilsøking)
  createdAt   DateTime      @default(now())
  paidAt      DateTime?

  @@index([spotId, startTime, endTime])
  @@index([apartmentId])
}

model Settings {
  id                  Int @id @default(1)
  pricePerHour        Int @default(20)
  pricePerDay         Int @default(100)
  dailyThresholdHours Int @default(5) // ved denne varigheten eller mer brukes døgnpris
}
